rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      allow create, read, update: if true;
      allow delete: if request.auth != null && request.auth.token.email == 'luwengstudio@gmail.com';

      match /photos/{photoId} {
        allow create, read: if true;
        allow update, delete: if request.auth != null && request.auth.token.email == 'luwengstudio@gmail.com';
      }

      match /wishes/{wishId} {
        allow read, create: if true;
        allow update, delete: if request.auth != null && request.auth.token.email == 'luwengstudio@gmail.com';
      }
    }

    match /slugs/{slugId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null && request.auth.token.email == 'luwengstudio@gmail.com';
    }

    match /guestbook/{themeFile}/messages/{messageId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null && request.auth.token.email == 'luwengstudio@gmail.com';
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
