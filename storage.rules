rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /orders/{orderCode}/{allPaths=**} {
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024;
      allow read: if true;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
